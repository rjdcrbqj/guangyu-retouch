{
  "name": "guangyu-retouch",
  "version": "0.8.3",
  "private": true,
  "description": "光屿修图 Windows 离线修图工作台",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:desktop": "node tests/desktop.mjs",
    "start": "electron .",
    "test:native": "node --test tests/native-selection.test.cjs",
    "test:wrinkle-desktop": "node tests/desktop-wrinkle.mjs",
    "test:updates": "node --test tests/updates.test.cjs tests/shortcuts.test.mjs tests/view-zoom.test.mjs",
    "test:hair": "node --test tests/hair-*.test.cjs",
    "release": "python tools/release.py"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "playwright": "1.62.1",
    "sharp": "0.35.5"
  }
}
